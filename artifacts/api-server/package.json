{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:quickex": "node ./test/run.mjs quickex.test.ts",
    "test:migrations": "NODE_ENV=test node ./test/run.mjs versioned-migration.test.ts",
    "test:revenue": "node ./test/run.mjs manual-desk-revenue.test.ts",
    "test:pricing-coverage": "node ./test/run.mjs manual-pricing-coverage.test.ts",
    "test:manual-path": "NODE_ENV=test node ./test/run.mjs manual-path-pricing.test.ts",
    "test:operators": "NODE_ENV=test node ./test/run.mjs operator-access.test.ts",
    "test:telegram": "NODE_ENV=test node ./test/run.mjs telegram.test.ts",
    "test:affiliate": "NODE_ENV=test node ./test/run.mjs affiliate.test.ts",
    "test:landing-background": "NODE_ENV=test node ./test/run.mjs landing-background.test.ts",
    "test:object-storage": "NODE_ENV=test node ./test/run.mjs object-storage.test.ts",
    "test:site-content": "NODE_ENV=test node ./test/run.mjs site-content-contract.test.ts && NODE_ENV=test node ./test/run.mjs site-content-routes.test.ts",
    "test:newsletter": "NODE_ENV=test node ./test/run.mjs newsletter-contract.test.ts",
    "export:workspace-config": "NODE_ENV=development WORKSPACE_CONFIG_EXPORT=1 esbuild ./src/scripts/export-workspace-config.ts --bundle --platform=node --format=cjs --external:pg-native --external:sharp '--external:@google-cloud/*' '--external:*.node' --outfile=./dist/export-workspace-config.cjs && WORKSPACE_CONFIG_EXPORT=1 node ./dist/export-workspace-config.cjs --",
    "blog:covers:regenerate": "esbuild ./src/scripts/regenerate-blog-covers.ts --bundle --platform=node --format=cjs --external:sharp '--external:@google-cloud/*' '--external:*.node' --external:pg-native --outfile=./dist/regenerate-blog-covers.cjs && node ./dist/regenerate-blog-covers.cjs",
    "test:api": "node ./test/run-api-isolated.mjs",
    "test:api:raw": "NODE_ENV=test node ./test/run.mjs blockchain-monitoring-service.test.ts && NODE_ENV=test node ./test/run.mjs blockchain-monitoring-adapters.test.ts && NODE_ENV=test node ./test/run.mjs bitcoin-monitoring-adapters.test.ts && NODE_ENV=test node ./test/run.mjs manual-monitoring-readiness.test.ts && NODE_ENV=test node ./test/run.mjs watch-registration-integration.test.ts && NODE_ENV=test node ./test/run.mjs verified-funding-projection.test.ts && pnpm run test:revenue && pnpm run test:pricing-coverage && pnpm run test:manual-path && pnpm run test:quickex && pnpm run test:operators && pnpm run test:telegram && pnpm run test:affiliate && pnpm run test:landing-background && pnpm run test:object-storage && pnpm run test:site-content && pnpm run test:newsletter && pnpm run test:whitebit && pnpm -w run test:quote-browser",
    "test:whitebit": "NODE_ENV=test node ./test/run-whitebit-isolated.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.61",
    "@clerk/shared": "^4.29.3",
    "@google-cloud/storage": "^8.0.1",
    "fast-xml-parser": "^5.11.0",
    "sanitize-html": "^2.17.0",
    "undici": "^7.16.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "ipaddr.js": "^1.9.1",
    "openai": "^5.19.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.5",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
